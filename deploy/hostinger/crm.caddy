crm.scalaris.com.ar {
	encode zstd gzip
	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	request_body {
		max_size 11MiB
	}
	@privateOperations {
		path /actuator/*
		not path /actuator/health /actuator/health/*
	}
	respond @privateOperations 404
	reverse_proxy scalaris-crm-frontend:8080 {
		header_up -Forwarded
		header_up -X-Forwarded-Port
		header_up -X-Forwarded-Prefix
		header_up -X-Forwarded-Ssl
	}
}
