# PostgreSQL local. Replace the password outside Git.
DATABASE_URL=jdbc:postgresql://localhost:5432/gestudio_crm
DATABASE_USER=gestudio
DATABASE_PASSWORD=change-me-locally
DATABASE_POOL_SIZE=10
DATABASE_MIN_IDLE=1

# Temporary development access. Leave empty to deny every business API request.
CRM_BOOTSTRAP_USERNAME=
CRM_BOOTSTRAP_PASSWORD=

# Sending remains blocked until a later, explicitly authorized segment.
SENDING_ENABLED=false
SENDING_DRY_RUN=true
SENDING_DAILY_LIMIT=0
SENDING_KILL_SWITCH=true

PORT=8080
