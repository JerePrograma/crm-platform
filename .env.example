# Local ports. Docker Compose binds only to 127.0.0.1.
POSTGRES_HOST_PORT=55432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173

# PostgreSQL local. Docker Compose reads this file automatically when it is copied to .env.
POSTGRES_DB=gestudio_crm
DATABASE_URL=jdbc:postgresql://localhost:55432/gestudio_crm
DATABASE_USER=gestudio
DATABASE_PASSWORD=gestudio_local_only
DATABASE_POOL_SIZE=10
DATABASE_MIN_IDLE=1

# First local administrator. Used only when the database has no active administrator.
CRM_BOOTSTRAP_USERNAME=gestudio-admin
CRM_BOOTSTRAP_PASSWORD=change-this-local-password
CRM_MINIMUM_PASSWORD_LENGTH=12
SESSION_COOKIE_SECURE=false

# Sending remains blocked. Keep the complete boundary explicit in local files.
SENDING_ENABLED=false
SENDING_DRY_RUN=true
SENDING_DAILY_LIMIT=0
SENDING_KILL_SWITCH=true
MESSAGING_REAL_NETWORK_ALLOWED=false
EMAIL_PROVIDER_MODE=NOOP
WHATSAPP_PROVIDER_MODE=DEEPLINK_ONLY

# Gmail live delivery remains unusable unless every value below is supplied by
# the runtime secret store and all sending gates above are explicitly opened.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=
GMAIL_FRONTEND_RETURN_URI=
GMAIL_OAUTH_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GMAIL_OAUTH_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_OAUTH_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
GMAIL_OAUTH_REVOCATION_URL=https://oauth2.googleapis.com/revoke
GMAIL_API_BASE_URL=https://gmail.googleapis.com
GMAIL_OAUTH_SCOPES=openid email https://www.googleapis.com/auth/gmail.send
GMAIL_TOKEN_ENCRYPTION_KEYS=
GMAIL_TOKEN_ENCRYPTION_ACTIVE_KEY_ID=
GMAIL_UNSUBSCRIBE_PUBLIC_BASE_URL=
GMAIL_UNSUBSCRIBE_SIGNING_KEY=
GMAIL_UNSUBSCRIBE_SIGNING_KEY_ID=
GMAIL_OAUTH_STATE_TTL=10m
GMAIL_HTTP_TIMEOUT=10s
GMAIL_HARD_DAILY_LIMIT=10
GMAIL_MAX_CONCURRENCY=1
GMAIL_ALLOW_TEST_ENDPOINTS=false

# Asynchronous work is opt-in locally. The webhook secret must be supplied only
# through the environment and must never be committed.
OUTBOX_WORKER_ENABLED=false
OUTBOX_WORKER_BATCH_SIZE=20
OUTBOX_WORKER_POLL_DELAY=5s
OUTBOX_WORKER_LEASE=2m
FAKE_INBOUND_ENABLED=false
FAKE_INBOUND_WEBHOOK_SECRET=
FAKE_INBOUND_SIGNATURE_WINDOW=5m
FAKE_INBOUND_MAX_PAYLOAD_BYTES=32768
FAKE_INBOUND_REQUESTS_PER_MINUTE=60

# Port used when the backend runs directly on the host, outside Docker Compose.
PORT=8080
