# Local ports. Docker Compose binds only to 127.0.0.1.
POSTGRES_HOST_PORT=55432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173

# PostgreSQL local. Docker Compose reads this file automatically when it is copied to .env.
POSTGRES_DB=gestudio_crm
DATABASE_URL=jdbc:postgresql://localhost:55432/gestudio_crm
DATABASE_USER=gestudio
DATABASE_PASSWORD=gestudio_local_only
DATABASE_POOL_SIZE=10
DATABASE_MIN_IDLE=1

# Temporary development access. Both values are required; empty values deny every business API request.
CRM_BOOTSTRAP_USERNAME=gestudio-admin
CRM_BOOTSTRAP_PASSWORD=change-this-local-password

# Sending remains blocked until a later, explicitly authorized segment.
SENDING_ENABLED=false
SENDING_DRY_RUN=true
SENDING_DAILY_LIMIT=0
SENDING_KILL_SWITCH=true

# Port used when the backend runs directly on the host, outside Docker Compose.
PORT=8080
