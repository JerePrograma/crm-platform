FROM node:22-alpine

WORKDIR /opt/fake-google
COPY --chown=node:node fake-google-server.mjs ./fake-google-server.mjs

USER node
EXPOSE 19090
HEALTHCHECK --interval=3s --timeout=2s --retries=20 --start-period=2s \
  CMD node -e "fetch('http://127.0.0.1:19090/__fake-google__/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

ENTRYPOINT ["node", "/opt/fake-google/fake-google-server.mjs"]
